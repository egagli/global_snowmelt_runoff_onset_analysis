# large data directories (see data/README.md for provenance)
# data/ holds ALL inputs (geometries, era5, hillshade, snotel archive);
# aggregated_results/<version>/ holds pipeline outputs — both regenerable.
/aggregated_results/
/scratch/
/data/*
!/data/README.md
!/data/gtopo30_lat_elev_histogram.nc   # 40 KB, required by the reduce (rebuild: reduce_partials.py --build-gtopo30)

# figures: one tracked set per dataset version (analyses/<unit>/figures/<version>/), except the
# machine-generated sweeps (one file per mountain range / region-year), which are regenerable —
# see analyses/README.md.
analyses/mountain_ranges/figures/**/triplets/
analyses/mountain_ranges/figures/**/anomaly_scatterplots/
analyses/mountain_ranges/figures/**/regional_panels/*.png

# staging area of material that leaves this repository at the public export (see private/README.md)
private/**/*.png
private/**/*.pdf

# secrets / tokens
config/sas_token.txt
config/ee_key.json

# environments & build artifacts
.pixi/
.venv/
build/
__pycache__/
*.egg-info/
*.py[cod]

# logs & temp files
logs/
*.log
*.tif
*.tiff
*.ovr*
*.tmp

# editor / jupyter cruft
.ipynb_checkpoints/
.vscode/
.DS_Store

# Claude Code agent worktrees / scratch state
.claude/

# CI fixture outputs (the reduce writes next to the fixture partials)
tests/fixtures/aggregated_results/*/*/
!tests/fixtures/aggregated_results/*/partials/
