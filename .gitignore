# inputs and caches — data/README.md says where each comes from and how it is rebuilt
/data/*
!/data/README.md
/partials/
# the cubes and zonal means, regenerable by analyses/<unit>/0_aggregate_by_<unit>.ipynb
analyses/*/data/aggregation/
# downloaded polygons (GMBA, BasinATLAS, USGS continents); the small tracked tables are listed below
analyses/*/data/geometries/*
!analyses/river_basins/data/geometries/hydrobasins_level6_population.csv
# self-downloaded station archive + climatology cache of the Evan & Eisenman comparison
analyses/climate/temperature_sensitivity_comparison/data/
/scratch/

# figures: one tracked set per dataset version (analyses/<unit>/figures/<version>/), except the
# machine-generated sweeps (one file per mountain range / region-year), which are regenerable —
# see analyses/README.md.
analyses/mountain_ranges/figures/**/triplets/
analyses/mountain_ranges/figures/**/anomaly_scatterplots/
analyses/mountain_ranges/figures/**/regional_panels/*.png

# secrets / tokens
config/sas_token.txt
config/ee_key.json

# environments & build artifacts
.pixi/
.venv/
build/
__pycache__/
*.egg-info/
*.py[cod]

# logs & temp files
logs/
*.log
*.tif
*.tiff
*.ovr*
*.tmp

# editor / jupyter cruft
.ipynb_checkpoints/
.vscode/
.DS_Store

# Claude Code agent worktrees / scratch state
.claude/
